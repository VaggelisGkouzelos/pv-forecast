#!/bin/bash
# Διπλό κλικ: βρίσκει τις ώρες με περικοπή/βλάβη, τις πετάει και ξαναεκπαιδεύει το μοντέλο.
# (Χρειάζεται να έχει τρέξει πρώτα το ΒΗΜΑ2, γιατί διαβάζει τον πίνακα που έφτιαξε εκείνο.)

cd "$(dirname "$0")"
source .venv/bin/activate
echo ">> Τρέχω το 03_katharismos.py"
echo ""
python3 03_katharismos.py
echo ""
echo ">> Τέλος! Μπορείς να κλείσεις αυτό το παράθυρο."
