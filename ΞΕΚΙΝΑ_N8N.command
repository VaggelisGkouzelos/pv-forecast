#!/bin/bash
# ============================================================
# Διπλό κλικ: ξεκινάει το n8n στο Mac σου.
# Μετά το ανοίγεις στον browser: http://localhost:5678
# ΟΣΟ ΤΡΕΧΕΙ ΤΟ n8n, ΑΥΤΟ ΤΟ ΠΑΡΑΘΥΡΟ ΠΡΕΠΕΙ ΝΑ ΜΕΙΝΕΙ ΑΝΟΙΧΤΟ.
# (Για να το σταματήσεις: κλείσε το παράθυρο ή πάτα Ctrl + C.)
# ============================================================

cd "$(dirname "$0")"

# 1. Υπάρχει Node.js; (το n8n είναι γραμμένο σε JavaScript και τρέχει πάνω στο Node.js)
if ! command -v node >/dev/null 2>&1; then
  echo ""
  echo "❌ Δεν βρέθηκε το Node.js."
  echo "   Σου ανοίγω τη σελίδα λήψης: κατέβασε την έκδοση 'LTS' (macOS Installer .pkg),"
  echo "   κάνε εγκατάσταση με τις προεπιλογές και μετά ξανακάνε διπλό κλικ εδώ."
  open "https://nodejs.org/en/download"
  exit 1
fi
echo "✅ Node.js: $(node --version)"

# 2. Ρύθμιση: ενεργοποιούμε τον κόμβο "Execute Command".
#    Στο n8n 2.x είναι κλειδωμένος από προεπιλογή για ασφάλεια. Τον χρειαζόμαστε
#    για να τρέχει το n8n τα δικά μας Python scripts.
export NODES_EXCLUDE="[]"

# Ο φάκελος του project (για να τον "βρίσκει" το n8n όταν τρέχει τα scripts)
export PV_FORECAST_DIR="$(pwd)"

# 3. Άνοιξε τον browser μόλις ξεκινήσει (περιμένουμε λίγο να "σηκωθεί")
( sleep 25; open "http://localhost:5678" ) &

# 4. Ξεκίνα το n8n. Την ΠΡΩΤΗ φορά κατεβαίνει (2-5 λεπτά), μετά είναι γρήγορο.
echo ">> Ξεκινάω το n8n (την πρώτη φορά θα αργήσει λίγο, κατεβαίνει)..."
npx --yes n8n
